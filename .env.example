# ==============================================================================
# ULTRON OS 2026 — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development and populate real credentials.
# NEVER commit `.env` or real secrets to GitHub or Google Drive.
# ==============================================================================

# --- Runtime & Application ---
ULTRON_ENV=development
ULTRON_APP_NAME="ULTRON OS 2026 Backend"
ULTRON_APP_VERSION=2026.4.0
ULTRON_HOST=127.0.0.1
ULTRON_PORT=8000
ULTRON_LOG_LEVEL=INFO
ULTRON_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ULTRON_RATE_LIMIT_PER_MIN=180
# Shared production rate limiter (recommended for multi-instance Vercel serverless)
ULTRON_REDIS_REST_URL=
ULTRON_REDIS_REST_TOKEN=
ULTRON_ARGON_MAX_PARALLEL_STEPS=4
ULTRON_ARGON_DEFAULT_STEP_RETRIES=1
ULTRON_ARGON_STEP_TIMEOUT_SECONDS=30

# --- ARGON Cryptographic Security (REQUIRED in production) ---
ULTRON_JWT_SECRET=replace-with-strong-random-secret-at-least-32-chars
ULTRON_VAULT_MASTER_KEY=replace-with-strong-vault-master-key-at-least-32-chars
ULTRON_ACCESS_TOKEN_TTL_SECONDS=900
ULTRON_REFRESH_TOKEN_TTL_DAYS=7
ULTRON_MAX_FAILED_LOGINS=5
ULTRON_LOCKOUT_MINUTES=15

# --- ApprovalGate Financial & Mutation Governance ---
ULTRON_APPROVAL_SOFT_LIMIT_USD=50.0
ULTRON_DEFAULT_TENANT_ID=TENANT-ULTRON-01

# --- Database Persistence (Supabase PostgreSQL primary, SQLite WAL local fallback) ---
ULTRON_DATABASE_URL=
ULTRON_SQLITE_PATH=./data/ultron_os_2026.db
ULTRON_DB_POOL_SIZE=10
ULTRON_DB_MAX_OVERFLOW=20

# --- Supabase Integration (NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ultron-private-files

# --- Multi-Model LLM Providers (Official Nov 2026 Gemini Models Primary + Failover) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STANDARD=gemini-3.8-flash
GEMINI_MODEL_REASONING=gemini-4-argon
GEMINI_MODEL_EMBEDDING=gemini-embedding-001
GEMINI_MODEL_IMAGE=gemini-nano-banana-2.1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_FALLBACK=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL_FALLBACK=claude-3-5-sonnet-latest

OLLAMA_BASE_URL=
OLLAMA_MODEL_LOCAL=llama3.2

# --- OAuth 2.0 Client Credentials (Google Ecosystem & GitHub) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth/github/callback

# --- Optional Direct Service Tokens (or connect per-tenant via OAuth / IntegrationManager) ---
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_GMAIL_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_DOCS_ACCESS_TOKEN=
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SLIDES_ACCESS_TOKEN=
GOOGLE_CLOUD_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# --- Vercel Integration ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_WEBHOOK_SECRET=

# --- Cloudflare Integration ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# --- Extended Tool Integrations ---
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=epejuwon-sketch/ULTRON
EMAIL_SMTP_HOST=
EMAIL_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PAYMENT_PROVIDER_KEY=
